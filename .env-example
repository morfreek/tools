# ---- Frontend (Vite las incrusta en el build: reconstruir tras cambiarlas) ----
# basename de React Router; debe coincidir con `base` de vite.config.js
VITE_BASE_URL=/tools
# URL pública de la API (Apache hace proxy de /tools/api a localhost:3001)
VITE_API_URL=https://localhost/tools/api

# ---- API (Node no lee este archivo: se definen en PM2/systemd o en la shell) ----
# PORT=3001
# DB_PATH=/var/www/html/private/apps/tools/projects.sqlite
# CONFIGS_DIR=/var/www/html/private/apps/tools/data/configs
